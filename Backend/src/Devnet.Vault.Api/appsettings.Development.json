{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MySqlConnection": "Server=localhost;Port=3306;Database=Vault;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;AllowPublicKeyRetrieval=True;SslMode=None;Pooling=true;DefaultCommandTimeout=30;TreatTinyAsBoolean=True;Charset=utf8mb4;",
    "RedisConnection": "localhost:6379,password=YOUR_REDIS_PASSWORD,abortConnect=False"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_LONG_SECURE_SECRET_KEY",
    "Issuer": "DevVault",
    "Audience": "DevVaultUsers",
    "ExpiryMinutes": 60
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "SenderEmail": "noreply@example.com",
    "SenderName": "Devnet Vault"
  },
  "EncryptionSettings": {
    "AesKey": "REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY",
    "AesIV": "REPLACE_WITH_A_BASE64_ENCODED_16_BYTE_IV",
    "AppKey": "REPLACE_WITH_A_SECURE_APP_KEY"
  }
}
